{
  "name": "@sudobility/sider_ui",
  "version": "0.0.42",
  "description": "Sider shared UI — dashboard pages and components for sider_app and sider_extension.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "verify": "bun run typecheck && bun run test:unit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2",
    "@sudobility/components": "^5.3.43",
    "@sudobility/design": "^1.1.66",
    "@sudobility/sider_client": "^0.1.25",
    "@sudobility/sider_types": "^0.0.19",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@heroicons/react": "~2.2.0",
    "@sudobility/components": "^5.3.43",
    "@sudobility/design": "^1.1.66",
    "@sudobility/sider_client": "^0.1.25",
    "@sudobility/sider_types": "^0.0.19",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~18.3.31",
    "eslint": "~9.39.5",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sider_ui.git"
  }
}
