{
  "name": "@sudobility/sider_ui",
  "version": "0.0.55",
  "description": "Sider shared UI — dashboard pages and components for sider_app and sider_extension.",
  "license": "BUSL-1.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --passWithNoTests",
    "verify": "bun run typecheck && bun run test:unit"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2",
    "@sudobility/components": "^5.3.61",
    "@sudobility/design": "^1.1.69",
    "@sudobility/sider_client": "^0.1.27",
    "@sudobility/sider_types": "^0.0.21",
    "@sudobility/types": "^1.9.78",
    "@tanstack/react-query": ">=5",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@heroicons/react": "~2.2.0",
    "@sudobility/components": "^5.3.61",
    "@sudobility/design": "^1.1.69",
    "@sudobility/sider_client": "^0.1.27",
    "@sudobility/sider_types": "^0.0.21",
    "@sudobility/types": "^1.9.78",
    "@tanstack/react-query": "~5.104.5",
    "@types/react": "~19.3.0",
    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.46.0",
    "vitest": "~4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/sider_ui.git"
  }
}
